{
  "name": "lpin-suite",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "overrides": {
    "nf3": "0.3.17"
  },
  "scripts": {
    "dev": "vite dev --host 127.0.0.1 --port 8090",
    "dev:lab": "vite dev --host 127.0.0.1 --port 8090 --mode lab",
    "build": "node scripts/assert-public-build.mjs && vite build",
    "build:lab": "vite build --mode lab",
    "db:migrate": "node scripts/migrate.mjs",
    "build:dev": "vite build --mode development",
    "preview": "vite preview --host 127.0.0.1 --port 8090",
    "assert:public-build": "node scripts/assert-public-build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "build:app": "node scripts/assert-public-build.mjs && vite build",
    "build:with-db": "node scripts/assert-public-build.mjs && vite build && node scripts/migrate.mjs",
    "qa": "node scripts/qa-lpin-suite.mjs",
    "qa:legacy": "node scripts/qa-apps.mjs",
    "test:e2e": "node scripts/qa-lpin-suite.mjs",
    "opsec:check": "node scripts/opsec-geo-check.mjs",
    "opsec:secrets": "node scripts/opsec-secrets-check.mjs",
    "opsec:portable": "node scripts/opsec-portable-check.mjs",
    "opsec:surface": "node scripts/opsec-surface-check.mjs",
    "audit:public": "node scripts/audit-public.mjs",
    "audit:public:fast": "node scripts/audit-public.mjs --skip-build",
    "qa:full": "npm run opsec:check && npm run qa",
    "test:portfolio": "node --experimental-strip-types scripts/qa-portfolio-comm.mjs --phase P0",
    "test:portfolio:p1": "node --experimental-strip-types scripts/qa-portfolio-comm.mjs --phase P1",
    "test:portfolio:p2": "node --experimental-strip-types scripts/qa-portfolio-comm.mjs --phase P2",
    "test:portfolio:p3": "node --experimental-strip-types scripts/qa-portfolio-comm.mjs --phase P3",
    "test:portfolio:p4": "node --experimental-strip-types scripts/qa-portfolio-comm.mjs --phase P4",
    "test:portfolio:p5": "node --experimental-strip-types scripts/qa-portfolio-comm.mjs --phase P5",
    "test:portfolio:p6": "node --experimental-strip-types scripts/qa-portfolio-comm.mjs --phase P6",
    "test:portfolio:ix": "node --experimental-strip-types scripts/qa-portfolio-comm.mjs --phase IX",
    "test:portfolio:gates": "node --experimental-strip-types scripts/qa-portfolio-comm.mjs --phase P0 && node --experimental-strip-types scripts/qa-portfolio-comm.mjs --phase P1 && node --experimental-strip-types scripts/qa-portfolio-comm.mjs --phase P2 && node --experimental-strip-types scripts/qa-portfolio-comm.mjs --phase P3 && node --experimental-strip-types scripts/qa-portfolio-comm.mjs --phase P4 && node --experimental-strip-types scripts/qa-portfolio-comm.mjs --phase P5 && node --experimental-strip-types scripts/qa-portfolio-comm.mjs --phase P6 && node --experimental-strip-types scripts/qa-portfolio-comm.mjs --phase IX",
    "test:portfolio:all": "node --experimental-strip-types scripts/qa-portfolio-comm.mjs --phase all"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.3",
    "@hookform/resolvers": "^5.0.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/vite": "^4.1.0",
    "@tanstack/react-query": "^5.90.0",
    "@tanstack/react-router": "^1.160.0",
    "@tanstack/react-start": "^1.160.0",
    "@tanstack/react-table": "^8.21.0",
    "@tanstack/router-plugin": "^1.160.0",
    "@types/node": "^22.16.5",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "better-auth": "^1.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.0.0",
    "kysely": "^0.28.5",
    "lightningcss": "^1.28.0",
    "lucide-react": "^0.510.0",
    "maplibre-gl": "^4.7.1",
    "nitro": "3.0.260603-beta",
    "pg": "^8.16.3",
    "react": "^19.1.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.54.0",
    "react-resizable-panels": "^4.6.5",
    "recharts": "^2.13.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.1.0",
    "tw-animate-css": "^1.3.4",
    "typescript": "^5.7.0",
    "vaul": "^1.1.2",
    "vite": "^8.1.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "playwright": "^1.52.0",
    "prettier": "^3.4.0",
    "typescript-eslint": "^8.56.1"
  },
  "engines": {
    "node": ">=20"
  }
}
